{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CubeCursor",
  "version": "0.2.0",
  "identifier": "shop.cubecursor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "CubeCursor",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "x": 0,
        "y": 0
      },
      {
        "label": "ghost",
        "title": "CubeCursor",
        "url": "ghost.html",
        "width": 140,
        "height": 76,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false,
        "x": 0,
        "y": 0
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "CubeCursor — one mouse and keyboard for all your Windows PCs",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": [
          "English"
        ],
        "compression": "lzma",
        "startMenuFolder": "CubeCursor"
      }
    },
    "publisher": "CubeCursor",
    "homepage": "https://cubecursor.shop",
    "copyright": "Copyright © 2026 CubeCursor. All rights reserved.",
    "licenseFile": "installer/EULA.txt",
    "longDescription": "CubeCursor shares one mouse and keyboard across your Windows PCs over your own network. Move the cursor off the edge of one screen and it appears on the next, with a shared clipboard and drag-and-drop file transfer.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "CubeCursor"
}